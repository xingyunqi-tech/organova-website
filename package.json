{
  "name": "organova-website",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "start": "next start",
    "preview": "next build && next start",
    "build": "next build",
    "commit": "czg",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix-unsafe": "biome check --write --unsafe .",
    "type-check": "tsc --noEmit",
    "spell-check": "cspell",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env scripts/seed-test-data.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "prepare": "npx husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "biome check --write --unsafe --no-errors-on-unmatched",
      "cspell --no-must-find-files"
    ],
    "*.json": [
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.css": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-secrets-manager": "^3.1159.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@trpc/client": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@uiw/react-codemirror": "^4.25.12",
    "ali-oss": "^6.23.0",
    "antd": "^6.6.8",
    "better-auth": "^1.7.14",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^4.6.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "nodemailer": "^10.3.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@types/ali-oss": "^6.23.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/postcss": "^66.12.0",
    "@unocss/reset": "^66.12.0",
    "@vitest/coverage-v8": "^5.0.5",
    "chalk": "^6.0.1",
    "cspell": "^10.4.0",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "drizzle-kit": "^0.31.11",
    "eruda": "^3.4.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sass": "^1.107.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
